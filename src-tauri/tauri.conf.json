{
  "$schema": "https://raw.githubusercontent.com/nicegui/nicegui/main/nicegui/static/tauri.conf.schema.json",
  "productName": "Orca",
  "version": "0.1.8",
  "identifier": "com.orca.desktop",
  "build": {
    "frontendDist": "../gui/dist",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": ""
  },
  "app": {
    "windows": [
      {
        "title": "Orca",
        "width": 1440,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600,
        "decorations": false,
        "transparent": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/orca-daemon"
    ],
    "windows": {
      "nsis": {
        "displayLanguageSelector": false
      }
    },
    "macOS": {
      "minimumSystemVersion": "12.0"
    },
    "linux": {
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0", "libssl3"]
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    },
    "publisher": "Edvin Syse",
    "category": "DeveloperTool",
    "shortDescription": "Container management desktop app with built-in AI",
    "longDescription": "Orca is an open source container management app. Manage Docker and Podman containers, images, compose stacks, and Kubernetes from a beautiful desktop UI with built-in AI assistant.",
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/edvin/orca/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDlERTgzMDJBMkI0N0M4RkYKUldUL3lFY3JLakRvblZ5SkNNbEYraGlPdUVIenk2eXZaVER2YzV4eUZ0OFhNZktHMGsrWmtuS3EK"
    }
  }
}
